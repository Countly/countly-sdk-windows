<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A .NET Framework 3.5 build runs on the 3.5 runtime when the machine has it, and on 4.x otherwise, as most apps that ship it do today. -->
  <startup>
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
