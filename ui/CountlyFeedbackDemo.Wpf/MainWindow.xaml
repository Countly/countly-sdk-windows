<Window x:Class="CountlyFeedbackDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countly Feedback Demo (WPF)" Height="460" Width="540">
    <StackPanel Margin="16">
        <TextBlock Text="Server URL" />
        <TextBox x:Name="ServerBox" Text="https://your-server.count.ly" />
        <TextBlock Text="App Key" Margin="0,8,0,0" />
        <TextBox x:Name="AppKeyBox" Text="YOUR_APP_KEY" />
        <Button x:Name="InitBtn" Content="Init &amp; Fetch Widgets" Margin="0,12,0,0" Padding="8,4" Click="InitBtn_Click" />
        <ListBox x:Name="WidgetList" Height="170" Margin="0,12,0,0" />
        <Button x:Name="ShowBtn" Content="Show Selected Widget" Margin="0,12,0,0" Padding="8,4" Click="ShowBtn_Click" />
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#555" />
    </StackPanel>
</Window>
